{
  "name": "TechCart",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios",
    "detox:build:ios": "detox build -c ios.sim.debug",
    "detox:test:ios": "detox test -c ios.sim.debug",
    "detox:build:android": "detox build -c android.emu.debug",
    "detox:test:android": "detox test -c android.emu.debug",
    "start": "react-native start --reset-cache",
    "start:clean": "watchman watch-del-all && rm -rf ios/build && npm start --reset-cache",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier . --write",
    "postinstall": "patch-package",
    "-------": "",
    "clean project": "rm -rf node_modules && rm -rf ios/build ios/Podfile.lock && rm -rf android/app/build && rm -rf /tmp/metro-* && rm -rf /tmp/haste-map-* && rm -rf yarn.lock package-lock.json",
    "---- clean Android ----": "",
    "android:gradle clean": "cd android && ./gradlew clean && cd ..",
    "android": "react-native run-android",
    "---- run Android ----": "",
    "android:dev": "cd android && ./gradlew installDevDebug && cd ..",
    "android:qa": "cd android && ./gradlew installQaDebug && cd ..",
    "android:uat": "cd android && ./gradlew installUatDebug && cd ..",
    "android:prod": "cd android && ./gradlew installProdRelease && cd ..",
    "---- build APK Android ----": "",
    "android:dev:build": "cd android && ./gradlew assembleDevDebug && cd ..",
    "android:qa:build": "cd android && ./gradlew assembleQaDebug && cd ..",
    "android:uat:build": "cd android && ./gradlew assembleUatDebug && cd ..",
    "android:prod:build": "cd android && ./gradlew assembleProdRelease && cd ..",
    "android:prod:build_aab": "cd android && ./gradlew bundleProdRelease && cd ..",
    "---- iOS ----": "",
    "ios:pods de-integrate": "cd ios && rm -rf Pods Podfile.lock && pod deintegrate",
    "ios:pod install": "cd ios && pod install --repo-update && cd ..",
    "---- clean iOS ----": "",
    "ios:clean:build folder:dev": "xcodebuild clean -workspace ios/NimiKash.xcworkspace -scheme 'NimiKash Dev'",
    "ios:clean:build folder:qa": "xcodebuild clean -workspace ios/NimiKash.xcworkspace -scheme 'NimiKash QA'",
    "ios:clean:build folder:uat": "xcodebuild clean -workspace ios/NimiKash.xcworkspace -scheme 'NimiKash UAT'",
    "ios:clean:build folder:prod": "xcodebuild clean -workspace ios/NimiKash.xcworkspace -scheme 'NimiKash'",
    "ios:clean:derived data": "rm -rf ~/Library/Developer/Xcode/DerivedData",
    "ios:clean:xcode cache": "rm -rf ~/Library/Developer/Xcode/ModuleCache.noindex",
    "ios:clean:pod install": "cd ios && rm -rf Pods Podfile.lock && pod install --repo-update && cd ..",
    "---- run iOS ----": "",
    "ios:dev": "npx react-native run-ios --scheme 'NimiKash Dev'",
    "ios:qa": "npx react-native run-ios --scheme 'NimiKash QA'",
    "ios:uat": "npx react-native run-ios --scheme 'NimiKash UAT'",
    "ios:prod": "npx react-native run-ios --scheme 'NimiKash'",
    "ios:archive:prod": "xcodebuild archive -workspace ios/NimiKash.xcworkspace -scheme NimiKash -configuration Release -sdk iphoneos -archivePath ios/build/NimiKashProd.xcarchive"
  },
  "dependencies": {
    "@react-native-community/slider": "^4.5.7",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/elements": "^2.5.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@react-navigation/stack": "^7.4.2",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.10.0",
    "axios-retry": "^4.5.0",
    "react": "19.0.0",
    "react-hook-form": "^7.60.0",
    "react-native": "0.78.2",
    "react-native-config": "^1.5.9",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-mmkv": "^3.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.1",
    "react-native-vector-icons": "^10.2.0",
    "react-redux": "^9.2.0",
    "redux-saga": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/eslint-config": "0.78.2",
    "@react-native/metro-config": "0.78.2",
    "@react-native/typescript-config": "0.78.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "detox": "^20.45.1",
    "eslint": "^8.19.0",
    "jest": "^30.2.0",
    "jest-circus": "^30.2.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
