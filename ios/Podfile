require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})',
  __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Define environments
ENVIRONMENTS = {
  "TechCart" => {
    :envfile => "$(PODS_ROOT)../.env.prod",
    :plist   => "Info.plist",
    :configs => ["Debug", "Release"]
  },
  "TechCart Dev" => {
    :envfile => "$(PODS_ROOT)../.env.dev",
    :plist   => "Info-Dev.plist",
    :configs => ["Debug Dev"]
  },
  "TechCart QA" => {
    :envfile => "$(PODS_ROOT)../.env.qa",
    :plist   => "Info-QA.plist",
    :configs => ["Debug QA"]
  },
  "TechCart UAT" => {
    :envfile => "$(PODS_ROOT)../.env.uat",
    :plist   => "Info-UAT.plist",
    :configs => ["Debug UAT"]
  }
}

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! linkage: linkage.to_sym
end

def shared_react_native_target(config)
  use_react_native!(
    path: config[:reactNativePath],
    app_path: "#{Pod::Config.instance.installation_root}/.."
  )
end

# Automatically create each environment target
ENVIRONMENTS.each do |target_name, env_config|
  target target_name do
    config = use_native_modules!
    shared_react_native_target(config)

    # Set the custom Info.plist for this target
    project_path = "TechCart.xcodeproj"
    if File.exist?(project_path)
      require 'xcodeproj'
      project = Xcodeproj::Project.open(project_path)
      native_target = project.targets.find { |t| t.name == target_name }
      if native_target
        native_target.build_configurations.each do |bc|
          if env_config[:configs].include?(bc.name)
            bc.build_settings['INFOPLIST_FILE'] = "TechCart/#{env_config[:plist]}"
          end
        end
        project.save
      end
    end
  end
end

post_install do |installer|
  react_native_post_install(installer)

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      next unless target.name == 'react-native-config'

      envfile = ENVIRONMENTS.values.find do |v|
        v[:configs].include?(config.name)
      end&.dig(:envfile)

      if envfile
        config.build_settings['ENVFILE'] = envfile
      else
        puts "⚠️ No ENVFILE mapped for #{config.name}"
      end
    end
  end
end
